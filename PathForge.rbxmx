-- Formatted messages: Lua pattern -&gt; function returning the Korean text.
local patterns={
    {"^(%d+) points   |   Node (%d+)   |   (.+)$",function(n,i,s) return "점 "..n.."개   |   노드 "..i.."   |   "..Locale.t(s) end},
    {"^Generator: (.+)$",function(s) return "생성기: "..Locale.t(s) end},
    {"^Mesh collision: (.+)$",function(s) return "메시 충돌: "..s end},
    {"^Material slot: (.+)$",function(s) return "재질 슬롯: "..s end},
    {"^Asset: (.+)$",function(s) return "에셋: "..s end},
    {"^(.+) / (.+) / (%d+) textures$",function(m,v,n) return m.." / "..(v=="default" and "기본" or v).." / 텍스처 "..n.."개" end},
    {"^(%d+) / (%d+)  |  (.+)$",function(i,n,s) return i.." / "..n.."  |  "..(s=="Missing source" and "소스 없음" or s) end},
    {"^Generated (%d+) parts | ([%d%.]+) studs%. Saved path can be reloaded%.$",function(n,l) return "파트 "..n.."개 생성 | "..l.." 스터드. 저장된 경로는 다시 불러올 수 있어요." end},
    {"^(%d+) geometry tests passed$",function(n) return "기하 테스트 "..n.."개 통과" end},
    {"^(%w+) must be between (%S+) and (%S+)$",function(k,lo,hi) return k.." 값은 "..lo.."~"..hi.." 사이여야 해요" end},
    {"^Preview: (.+)$",function(s) return "미리보기: "..Locale.t(s) end},
    {"^Invalid material: (.+)$",function(s) return "잘못된 재질: "..s end},
    {"^Mesh upload failed: (.+)$",function(s) return "메시 업로드 실패: "..s end},
    {"^Editor closed or play test started; uploaded asset ID: (.+)$",function(s) return "편집기가 닫혔거나 플레이 테스트가 시작됐어요. 이미 업로드된 에셋 ID: "..s end},
    {"^Mesh creation failed %(asset (.-)%): (.+)$",function(a,s) return "메시 생성 실패 (에셋 "..a.."): "..s end},
}

local function detect()
    local ok,id=pcall(function() return game:GetService("StudioService").StudioLocaleId end)
    if ok and type(id)=="string" and id:lower():sub(1,2)=="ko" then return "ko" end
    return "en"
end

Locale.language=detect()

function Locale.t(text)
    if Locale.language~="ko" or type(text)~="string" then return text end
    local v=ko[text]
    if v then return v end
    for _,p in ipairs(patterns) do
        local captures={text:match(p[1])}
        if #captures&gt;0 then return p[2](table.unpack(captures)) end
    end
    return text
end

return Locale
</ProtectedString></Properties></Item></Item></roblox>