    ["Authorize mesh uploads before Generate"]="생성하기 전에 메시 업로드 허용을 켜세요",
    ["Invalid collision switch"]="충돌 설정 값이 잘못됐어요",
    ["Invalid generator options"]="생성기 설정이 잘못됐어요",
    ["Invalid profile text"]="단면 텍스트가 잘못됐어요",
    ["Invalid saved generator"]="저장된 생성기가 잘못됐어요",
    ["Not a part-based generator"]="파트 기반 생성기가 아니에요",
    ["Select a MeshPart for the Deform generator"]="변형 생성기에 쓸 MeshPart를 선택하세요",
    ["Select a custom asset for the Custom generator"]="커스텀 생성기에 쓸 에셋을 선택하세요",
    ["JSON cannot store NaN or infinity"]="JSON에는 NaN이나 무한대를 저장할 수 없어요",
    ["JSON nesting too deep"]="JSON 중첩이 너무 깊어요",
    ["JSON object keys must be strings"]="JSON 객체 키는 문자열이어야 해요",
    ["JSON text expected"]="JSON 텍스트가 필요해요",
    ["Profile too detailed for one mesh; reduce profile sides"]="단면이 너무 세밀해서 메시 하나에 안 들어가요. 단면 분할 수를 줄이세요",

    -- v0.8 library
    ["Library"]="라이브러리",
    ["05   LIBRARY / SAVED WITH THIS PLACE"]="05   라이브러리 / 이 플레이스에 저장",
    ["05A  MATERIALS"]="05A  재질", ["05B  ASSETS"]="05B  에셋",
    ["05C  RECIPES (GENERATORS + LAYERS, NO POINTS)"]="05C  레시피 (생성기 + 레이어, 점 제외)",
    ["Name for saving"]="저장할 이름",
    ["Previous material"]="이전 재질", ["Next material"]="다음 재질",
    ["Previous asset"]="이전 에셋", ["Next asset"]="다음 에셋",
    ["Previous recipe"]="이전 레시피", ["Next recipe"]="다음 레시피",
    ["Apply material to current slot"]="현재 슬롯에 재질 적용",
    ["Save current slot to library"]="현재 슬롯을 라이브러리에 저장",
    ["Add selected model to library"]="선택한 모델을 라이브러리에 추가",
    ["Use as Custom asset"]="커스텀 에셋으로 사용",
    ["Add as repeat layer"]="반복 레이어로 추가",
    ["Save current setup as recipe"]="현재 설정을 레시피로 저장",
    ["Load recipe into draft"]="레시피를 초안에 불러오기",
    ["Library is empty"]="라이브러리가 비어 있어요",
    ["No saved recipes"]="저장된 레시피가 없어요",
    ["Saved to the library."]="라이브러리에 저장했어요.",
    ["Material applied to the current slot. Generate to apply."]="현재 슬롯에 재질을 적용했어요. 생성하면 반영돼요.",
    ["Layer added. Adjust it in the Layers tab."]="레이어를 추가했어요. 레이어 탭에서 조정하세요.",
    ["Recipe loaded into the draft. Points are unchanged; Generate to apply."]="레시피를 초안에 불러왔어요. 점은 그대로예요. 생성하면 반영돼요.",
    ["Materials, assets and recipes are stored in ServerStorage &gt; PathForgeLibrary and travel with this place. ★ marks your own materials."]="재질, 에셋, 레시피는 ServerStorage &gt; PathForgeLibrary에 저장되고 이 플레이스와 함께 다녀요. ★는 직접 저장한 재질이에요.",
    ["Capture or apply a material to this slot first"]="먼저 이 슬롯에 재질을 가져오거나 적용하세요",
    ["Enter a library name"]="라이브러리 이름을 입력하세요",
    ["Library names must be 1–50 characters"]="라이브러리 이름은 1~50자여야 해요",
    ["Library names cannot contain slashes"]="라이브러리 이름에는 / 나 \\ 를 쓸 수 없어요",
    ["Library is full (200 items)"]="라이브러리가 가득 찼어요 (200개)",
    ["Invalid material style"]="재질 설정이 잘못됐어요",
    ["PathForgeLibrary must be a Folder"]="PathForgeLibrary는 Folder여야 해요",
    ["Recipe data is missing"]="레시피 데이터가 없어요",
    ["Unsupported recipe format"]="지원하지 않는 레시피 형식이에요",
    ["Asphalt (dark)"]="아스팔트 (어두움)", ["Asphalt (worn)"]="아스팔트 (낡음)",
    ["Concrete (light)"]="콘크리트 (밝음)", ["Concrete (dark)"]="콘크리트 (어두움)",
    ["Pavement"]="포장 도로", ["Brick (red)"]="벽돌 (빨강)", ["Cobblestone"]="자갈길",
    ["Wood (oak)"]="나무 (참나무)", ["Wood (dark)"]="나무 (어두움)", ["Wood planks"]="나무 판자",
    ["Steel"]="강철", ["Rusty metal"]="녹슨 금속", ["Diamond plate"]="체크 철판",
    ["Marble (white)"]="대리석 (흰색)", ["Granite"]="화강암", ["Glass (clear)"]="유리 (투명)",
    ["Grass"]="잔디", ["Sand"]="모래", ["Neon (blue)"]="네온 (파랑)",
    ["Painted line (white)"]="도색 선 (흰색)", ["Painted line (yellow)"]="도색 선 (노랑)",

    -- v0.9 branches / junctions
    ["01A  BRANCHES"]="01A  분기",
    ["Branch snap radius (studs)"]="분기 스냅 반경 (스터드)",
    ["Snap path ends onto nearby paths"]="경로 끝을 근처 경로에 붙이기",
    ["No other path within the snap radius."]="스냅 반경 안에 다른 경로가 없어요.",
    ["Road junctions: ON"]="도로 교차로: 켬", ["Road junctions: OFF"]="도로 교차로: 끔",
    ["Snap radius must be positive"]="스냅 반경은 0보다 커야 해요",

    -- v0.9b terrain
    ["01B  TERRAIN"]="01B  지형",
    ["Height above ground (studs)"]="지면 위 높이 (스터드)",
    ["Drape resample spacing (0 = keep points)"]="지면 따라 다시 찍는 간격 (0 = 점 유지)",
    ["Drape points onto ground"]="점을 지면에 붙이기",
    ["Terrain shoulder each side (studs)"]="지형 양옆 여유 폭 (스터드)",
    ["Fill depth below path (studs)"]="경로 아래 채울 깊이 (스터드)",
    ["Clear height above path (studs)"]="경로 위 비울 높이 (스터드)",
    ["Fill and carve terrain along path"]="경로를 따라 지형 채우기 / 깎기",
    ["This place has no Terrain"]="이 플레이스에 Terrain이 없어요",
    ["Invalid terrain settings"]="지형 설정이 잘못됐어요",
    ["Resample spacing must be positive"]="다시 찍는 간격은 0보다 커야 해요",
    ["Too many points: increase resample spacing"]="점이 너무 많아요. 다시 찍는 간격을 늘리세요",
}

-- Formatted messages: Lua pattern -&gt; function returning the Korean text.
local patterns={
    {"^Fill material: (.+)$",function(m) return "채울 재질: "..m end},
    {"^Draped (%d+) of (%d+) points onto the ground%.$",function(a,b) return "점 "..b.."개 중 "..a.."개를 지면에 붙였어요." end},
    {"^Terrain: (%d+) fill and (%d+) carve blocks%. Undo reverts it in one step%.$",function(a,b) return "지형: 채우기 "..a.."개, 깎기 "..b.."개. 실행 취소 한 번으로 되돌릴 수 있어요." end},
    {"^Snapped (%d+) path end%(s%)%. Generate to build the branch%.$",function(n) return "경로 끝 "..n.."개를 붙였어요. 생성하면 분기가 만들어져요." end},
    {"^Part budget exceeded %((%d+)%)$",function(n) return "파트 한도("..n.."개)를 넘었어요" end},
    {"^Generator (%d+) / (%d+)  |  (.+)$",function(i,n,s) return "생성기 "..i.." / "..n.."  |  "..Locale.t(s) end},
    {"^Preview ready: (%d+) parts, (%d+) layer parts%. Nothing was uploaded%.$",function(a,b) return "미리보기 준비 완료: 파트 "..a.."개, 레이어 파트 "..b.."개. 업로드는 하지 않았어요." end},
    {"^(%d+) points   |   Node (%d+)   |   (.+)$",function(n,i,s) return "점 "..n.."개   |   노드 "..i.."   |   "..Locale.t(s) end},
    {"^Generator: (.+)$",function(s) return "생성기: "..Locale.t(s) end},
    {"^Mesh collision: (.+)$",function(s) return "메시 충돌: "..s end},
    {"^Material slot: (.+)$",function(s) return "재질 슬롯: "..s end},
    {"^Asset: (.+)$",function(s) return "에셋: "..s end},
    {"^(.+) / (.+) / (%d+) textures$",function(m,v,n) return m.." / "..(v=="default" and "기본" or v).." / 텍스처 "..n.."개" end},
    {"^(%d+) / (%d+)  |  (.+)$",function(i,n,s) return i.." / "..n.."  |  "..(s=="Missing source" and "소스 없음" or s) end},
    {"^Generated (%d+) parts | ([%d%.]+) studs%. Saved path can be reloaded%.$",function(n,l) return "파트 "..n.."개 생성 | "..l.." 스터드. 저장된 경로는 다시 불러올 수 있어요." end},
    {"^(%d+) geometry tests passed$",function(n) return "기하 테스트 "..n.."개 통과" end},
    {"^(%w+) must be between (%S+) and (%S+)$",function(k,lo,hi) return k.." 값은 "..lo.."~"..hi.." 사이여야 해요" end},
    {"^Preview: (.+)$",function(s) return "미리보기: "..Locale.t(s) end},
    {"^Invalid material: (.+)$",function(s) return "잘못된 재질: "..s end},
    {"^Mesh upload failed: (.+)$",function(s) return "메시 업로드 실패: "..s end},
    {"^Editor closed or play test started; uploaded asset ID: (.+)$",function(s) return "편집기가 닫혔거나 플레이 테스트가 시작됐어요. 이미 업로드된 에셋 ID: "..s end},
    {"^Mesh creation failed %(asset (.-)%): (.+)$",function(a,s) return "메시 생성 실패 (에셋 "..a.."): "..s end},
}

local function detect()
    local ok,id=pcall(function() return game:GetService("StudioService").StudioLocaleId end)
    if ok and type(id)=="string" and id:lower():sub(1,2)=="ko" then return "ko" end
    return "en"
end

Locale.language=detect()

function Locale.t(text)
    if Locale.language~="ko" or type(text)~="string" then return text end
    local v=ko[text]
    if v then return v end
    -- error() adds "Script:line: " in front; translate the message after it.
    local where,rest=text:match("^(.-:%d+: )(.+)$")
    if where then return where..Locale.t(rest) end
    for _,p in ipairs(patterns) do
        local captures={text:match(p[1])}
        if #captures&gt;0 then return p[2](table.unpack(captures)) end
    end
    return text
end

return Locale
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">Version</string><ProtectedString name="Source">-- Single source of the plugin version shown in the UI and written to saves.
return {FULL="0.9.1",SHORT="0.9b"}
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">Json</string><ProtectedString name="Source">-- Small deterministic JSON codec (sorted object keys). Used for saved settings,
-- recipes and cache keys so the same input always produces the same text.
-- Reads HttpService JSON written by earlier PathForge versions.
local J={}
local function isArray(t)
    local n=0
    for k in pairs(t) do
        if type(k)~="number" or k&lt;1 or k%1~=0 then return false end
        n+=1
    end
    for i=1,n do if t[i]==nil then return false end end
    return true,n
end
local escapes={['"']='\\"',["\\"]="\\\\",["\b"]="\\b",["\f"]="\\f",["\n"]="\\n",["\r"]="\\r",["\t"]="\\t"}
local function str(s)
    return '"'..s:gsub('[%c"\\]',function(c) return escapes[c] or string.format("\\u%04x",c:byte()) end)..'"'
end
local function encode(v,depth)
    assert(depth&lt;=32,"JSON nesting too deep")
    local t=type(v)
    if t=="nil" then return "null"
    elseif t=="boolean" then return tostring(v)
    elseif t=="number" then
        assert(v==v and v~=math.huge and v~=-math.huge,"JSON cannot store NaN or infinity")
        if v%1==0 and math.abs(v)&lt;2^53 then return string.format("%d",v) end
        return string.format("%.14g",v)
    elseif t=="string" then return str(v)
    elseif t=="table" then
        local array,n=isArray(v)
        local out={}
        if array then
            for i=1,n do out[i]=encode(v[i],depth+1) end
            return "["..table.concat(out,",").."]"
        end
        local keys={}
        for k in pairs(v) do assert(type(k)=="string","JSON object keys must be strings"); keys[#keys+1]=k end
        table.sort(keys)
        for i,k in ipairs(keys) do out[i]=str(k)..":"..encode(v[k],depth+1) end
        return "{"..table.concat(out,",").."}"
    end
    error("Cannot encode "..t.." as JSON",0)
end
function J.encode(v) return encode(v,0) end
function J.decode(s)
    assert(type(s)=="string","JSON text expected")
    local i=1
    local function ws() i=s:find("[^ \t\r\n]",i) or #s+1 end
    local function fail(msg) error("Invalid JSON at "..i..": "..msg,0) end
    local value
    local function readString()
        i+=1
        local out={}
        while true do
            local c=s:sub(i,i)
            if c=="" then fail("unterminated string") end
            if c=='"' then i+=1; break end
            if c=="\\" then
                local e=s:sub(i+1,i+1)
                local map={['"']='"',["\\"]="\\",["/"]="/",b="\b",f="\f",n="\n",r="\r",t="\t"}
                if map[e] then out[#out+1]=map[e]; i+=2
                elseif e=="u" then
                    local hex=s:sub(i+2,i+5)
                    local code=tonumber(hex,16); if not code or #hex&lt;4 then fail("bad escape") end
                    out[#out+1]=utf8.char(code); i+=6
                else fail("bad escape") end
            else out[#out+1]=c; i+=1 end
        end
        return table.concat(out)
    end
    value=function(depth)
        if depth&gt;32 then fail("nesting too deep") end
        ws()
        local c=s:sub(i,i)
        if c=="{" then
            i+=1; local t={}; ws()
            if s:sub(i,i)=="}" then i+=1; return t end
            while true do
                ws(); if s:sub(i,i)~='"' then fail("key expected") end
                local k=readString(); ws()
                if s:sub(i,i)~=":" then fail("':' expected") end
                i+=1; t[k]=value(depth+1); ws()
                local d=s:sub(i,i); i+=1
                if d=="}" then return t elseif d~="," then fail("',' or '}' expected") end
            end
        elseif c=="[" then
            i+=1; local t={}; ws()
            if s:sub(i,i)=="]" then i+=1; return t end
            while true do
                t[#t+1]=value(depth+1); ws()
                local d=s:sub(i,i); i+=1
                if d=="]" then return t elseif d~="," then fail("',' or ']' expected") end
            end
        elseif c=='"' then return readString()
        elseif s:sub(i,i+3)=="true" then i+=4; return true
        elseif s:sub(i,i+4)=="false" then i+=5; return false
        elseif s:sub(i,i+3)=="null" then i+=4; return nil
        else
            local num=s:match("^-?%d+%.?%d*[eE]?[-+]?%d*",i)
            local v=num and tonumber(num)
            if not v then fail("value expected") end
            i+=#num; return v
        end
    end
    local result=value(0); ws()
    if i&lt;=#s then fail("trailing text") end
    return result
end
return J
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX12"><Properties><string name="Name">Presets</string><ProtectedString name="Source">-- Built-in generators. Part-based generators return plain part specs
-- ({name, cf, size, material, color, shape}) so they can be tested and
-- previewed without creating Instances.
local G=require(script.Parent.Geometry)
local P={}
P.LIST={"Rail","Road","Wall","Fence","Pipe","Custom","Deform","Extrude"}
P.MESH={Deform=true,Extrude=true}
P.PART_BASED={Rail=true,Road=true,Wall=true,Fence=true,Pipe=true}
P.DEFAULTS={
    Rail={width=3.2,height=0.2,spacing=1.8,step=1},
    Road={width=12,height=0.35,spacing=8,step=2},
    Wall={width=0.8,height=8,spacing=5,step=2},
    Fence={width=0.3,height=4,spacing=5,step=2},
    Pipe={width=1.4,height=1.5,spacing=8,step=1},
    Custom={width=1,height=0,spacing=5,step=2},
    Deform={width=1,height=0,spacing=5,step=2},
    Extrude={width=6,height=1,spacing=5,step=2},
}
-- Material slot names each generator can produce, for the material slot picker.
P.SLOTS={
    Rail={"RailFoot","RailHead","Sleeper"},
    Road={"RoadSurface","EdgeLine","CenterMark"},
    Wall={"Wall"},
    Fence={"FenceRail","FencePost"},
    Pipe={"Pipe","Joint"},
    Custom={},
    Deform={},
    Extrude={"ExtrudedMesh"},
}
-- Numeric options shared by every generator: key -&gt; {min, max, default}.
P.NUMBERS={
    width={0.05,100,3.2}, height={-50,100,0.2}, spacing={0.2,200,1.8}, step={0.15,100,1},
    offset={-100,100,0}, yaw={-360,360,0}, roll={-360,360,0},
    sides={3,64,16}, uvLength={0.05,1000,4}, uvWidth={0.05,1000,4},
    angle={1,90,8}, tolerance={0.005,10,0.05},
}
P.FIDELITY={"Default","Box","Hull","PreciseConvexDecomposition"}
local STEEL={103,110,119}
local TIMBER={91,67,46}
local ASPHALT={54,58,63}
local CONCRETE={129,130,124}
local LINE={220,220,210}
local MARK={233,184,62}

function P.isPreset(name) return table.find(P.LIST,name)~=nil end

-- Default option table for a preset (used for new generators and old saves).
function P.options(preset)
    assert(P.isPreset(preset),"Unknown preset")
    local o={preset=preset,profile="rectangle",fidelity="Default",collide=true}
    for k,spec in pairs(P.NUMBERS) do o[k]=spec[3] end
    for k,v in pairs(P.DEFAULTS[preset]) do o[k]=v end
    return o
end

-- Validates and normalizes an option table in place; returns it.
function P.validate(o)
    assert(type(o)=="table","Invalid generator options")
    assert(P.isPreset(o.preset),"Unknown preset")
    for k,spec in pairs(P.NUMBERS) do
        local v=o[k]
        assert(type(v)=="number" and v==v and v&gt;=spec[1] and v&lt;=spec[2],k.." must be between "..spec[1].." and "..spec[2])
    end
    o.sides=math.floor(o.sides)
    assert(type(o.profile)=="string" and #o.profile&lt;=2000,"Invalid profile text")
    assert(table.find(P.FIDELITY,o.fidelity),"Invalid collision fidelity")
    assert(type(o.collide)=="boolean","Invalid collision switch")
    return o
end

local function axisCF(a,b,up)
    local v=b-a
    if v.Magnitude&lt;1e-5 then return nil,0 end
    if math.abs(v.Unit:Dot(up))&gt;0.995 then up=Vector3.new(0,0,1); if math.abs(v.Unit:Dot(up))&gt;0.995 then up=Vector3.new(1,0,0) end end
    return CFrame.lookAt((a+b)/2,b,up),v.Magnitude
end
P.axisCF=axisCF

-- Returns an array of part specs for a part-based preset.
function P.parts(path,o,limit,shown)
    assert(P.PART_BASED[o.preset],"Not a part-based generator")
    limit=limit or 6500; shown=shown or limit
    local specs={}
    local function add(name,cf,size,material,color,shape)
        assert(#specs&lt;limit,"Part budget exceeded ("..shown..")")
        specs[#specs+1]={name=name,cf=cf,size=size,material=material,color=color,shape=shape}
    end
    local function frame(d)
        local p,f,r,u=G.frame(path,d); return p+Vector3.new(0,o.offset,0),f,r,u
    end
    local function beam(name,a,b,up,w,h,mat,col,overlap)
        local cf,len=axisCF(a,b,up)
        if cf then add(name,cf,Vector3.new(w,h,len+(overlap or 0)),mat,col) end
    end
    if o.preset=="Wall" or o.preset=="Fence" or o.preset=="Road" then assert(o.height&gt;0,"Height must be positive for this preset") end
    local ds=G.segments(path,o.step,2000)
    -- Junction cuts (Road only): segment boundaries land exactly on cut edges.
    local cuts=o.preset=="Road" and o.cuts or {}
    local function inCut(d) for _,c in ipairs(cuts) do if d&gt;c[1]+1e-6 and d&lt;c[2]-1e-6 then return true end end return false end
    if #cuts&gt;0 then
        for _,c in ipairs(cuts) do ds[#ds+1]=c[1]; ds[#ds+1]=c[2] end
        table.sort(ds)
        local unique={ds[1]}
        for i=2,#ds do if ds[i]-unique[#unique]&gt;1e-5 then unique[#unique+1]=ds[i] end end
        ds=unique
    end
    local lastDir
    for i=1,#ds-1 do
        local a,_,ra,ua=frame(ds[i]); local b,_,rb,ub=frame(ds[i+1])
        local up=ua+ub; up=up.Magnitude&gt;1e-4 and up.Unit or ua
        if o.preset=="Rail" then
            for _,side in ipairs({-1,1}) do
                local aa=a+ra*o.width/2*side+ua*o.height
                local bb=b+rb*o.width/2*side+ub*o.height
                beam("RailFoot",aa,bb,up,0.30,0.10,"Metal",STEEL,0.06)
                beam("RailHead",aa+ua*0.11,bb+ub*0.11,up,0.13,0.17,"Metal",STEEL,0.06)
            end
        elseif o.preset=="Road" and not inCut((ds[i]+ds[i+1])/2) then
            -- Segments inside a junction cut are left to the junction pad.
            beam("RoadSurface",a-ua*o.height/2,b-ub*o.height/2,up,o.width,o.height,"Asphalt",ASPHALT,0.12)
            for _,side in ipairs({-1,1}) do
                beam("EdgeLine",a+ra*(o.width/2-0.3)*side+ua*0.025,b+rb*(o.width/2-0.3)*side+ub*0.025,up,0.10,0.035,"SmoothPlastic",LINE,0.06)
            end
        elseif o.preset=="Wall" then
            beam("Wall",a+ua*o.height/2,b+ub*o.height/2,up,o.width,o.height,"Concrete",CONCRETE,0.12)
        elseif o.preset=="Fence" then
            for _,h in ipairs({0.38,0.82}) do beam("FenceRail",a+ua*o.height*h,b+ub*o.height*h,up,o.width,0.20,"Wood",TIMBER,0.06) end
        elseif o.preset=="Pipe" then
            local aa=a+ua*o.height; local bb=b+ub*o.height
            local cf,len=axisCF(aa,bb,up)
            if cf then
                add("Pipe",cf*CFrame.Angles(0,math.pi/2,0),Vector3.new(len+0.04,o.width,o.width),"Metal",STEEL,"Cylinder")
                -- A joint ball only where the pipe actually bends.
                local dir=(bb-aa).Unit
                if lastDir and lastDir:Dot(dir)&lt;0.9999 then add("Joint",CFrame.new(aa),Vector3.new(o.width,o.width,o.width),"Metal",STEEL,"Ball") end
                lastDir=dir
            end
        end
    end
    if o.preset=="Rail" or o.preset=="Fence" or o.preset=="Road" then
        for _,d in ipairs(G.instances(path,o.spacing,2000)) do
            local p,f,_,u=frame(d); local cf=CFrame.lookAt(p,p+f,u)
            if o.preset=="Rail" then
                add("Sleeper",cf*CFrame.new(0,o.height-0.14,0),Vector3.new(o.width+1.25,0.20,0.40),"Wood",TIMBER)
            elseif o.preset=="Fence" then
                add("FencePost",cf*CFrame.new(0,o.height/2,0),Vector3.new(o.width*1.7,o.height,o.width*1.7),"Wood",TIMBER)
            else
                local len=math.min(2,o.spacing*0.45,path.length)
                if d-len/2&gt;=0 and d+len/2&lt;=path.length and not inCut(d-len/2) and not inCut(d+len/2) then add("CenterMark",cf*CFrame.new(0,0.028,0),Vector3.new(0.15,0.035,len),"SmoothPlastic",MARK) end
            end
        end
    end
    return P.merge(specs)
end

-- Joins consecutive collinear beams of the same kind into one longer part.
-- Straight stretches become a single part; curved geometry is unchanged.
local function beamKey(s)
    return string.format("%s|%.4f|%.4f|%s|%d,%d,%d",s.name,s.size.X,s.size.Y,s.material,s.color[1],s.color[2],s.color[3])
end
local function ends(s)
    local look=s.cf.LookVector
    local half=look*(s.size.Z/2)
    return s.cf.Position-half,s.cf.Position+half,look
end
function P.merge(specs)
    local out={}
    local tails={} -- key -&gt; list of indexes in out that may still grow
    for _,s in ipairs(specs) do
        local merged=false
        if not s.shape then
            local key=beamKey(s)
            local list=tails[key] or {}
            tails[key]=list
            local sa,sb,look=ends(s)
            for _,idx in ipairs(list) do
                local t=out[idx]
                local ta,tb,tlook=ends(t)
                local gap=sa-tb
                local offAxis=gap-tlook*gap:Dot(tlook)
                if tlook:Dot(look)&gt;0.99999 and t.cf.UpVector:Dot(s.cf.UpVector)&gt;0.99999
                    and offAxis.Magnitude&lt;1e-3 and math.abs(gap:Dot(tlook))&lt;=0.2 then
                    local len=(sb-ta):Dot(tlook)
                    local center=ta+tlook*(len/2)
                    out[idx]={name=t.name,cf=CFrame.lookAt(center,center+tlook,t.cf.UpVector),
                        size=Vector3.new(t.size.X,t.size.Y,len),material=t.material,color=t.color}
                    merged=true
                    break
                end
            end
            if not merged then out[#out+1]=s; list[#list+1]=#out end
        else
            out[#out+1]=s
        end
    end
    return out
end
return P
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX13"><Properties><string name="Name">Assets</string><ProtectedString name="Source">-- Source asset checks and safe cloning (scripts, joints and prompts removed).
local A={}
local STRIP={"LuaSourceContainer","JointInstance","Constraint","WeldConstraint","ProximityPrompt","ClickDetector"}
-- Returns the number of BaseParts in a valid Model/BasePart source.
function A.count(a)
    assert(a and (a:IsA("Model") or a:IsA("BasePart")),"Select a Model or BasePart")
    assert(a.Archivable,"Asset must be Archivable")
    assert(not a:IsA("Terrain"),"Terrain cannot be used as a static asset")
    local count=a:IsA("BasePart") and 1 or 0
    for _,d in ipairs(a:GetDescendants()) do
        if d:IsA("BasePart") then count+=1; assert(d.Archivable,"All source BaseParts must be Archivable") end
    end
    assert(count&gt;0,"Asset contains no BaseParts")
    return count
end
function A.clone(a)
    local c=a:Clone(); assert(c,"Cannot clone asset")
    for _,d in ipairs(c:GetDescendants()) do
        for _,class in ipairs(STRIP) do
            if d:IsA(class) then d:Destroy(); break end
        end
    end
    return c
end
-- Anchors every part of a placed clone; previews are also hidden from raycasts and saves.
function A.configure(c,collide,preview)
    local function set(part)
        part.Anchored=true; part.CanCollide=collide and not preview; part.CanTouch=false
        if preview then part.CanQuery=false; part.Archivable=false end
    end
    if c:IsA("BasePart") then set(c) end
    for _,d in ipairs(c:GetDescendants()) do if d:IsA("BasePart") then set(d) end end
end
return A
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">Builder</string><ProtectedString name="Source">-- Turns a generator stack into Instances. Part-based and Custom generators are
-- built first so budget failures happen before any mesh upload starts.
local G=require(script.Parent.Geometry)
local P=require(script.Parent.Presets)
local Assets=require(script.Parent.Assets)
local Materials=require(script.Parent.Materials)
local Extrude=require(script.Parent.Extrude)
local Deform=require(script.Parent.Deform)
local Json=require(script.Parent.Json)
local Network=require(script.Parent.Network)
local B={MAX_PARTS=6500}

function B.part(parent,spec,collide,preview,style)
    local p=Instance.new("Part")
    p.Name=spec.name
    p.Size=Vector3.new(math.max(spec.size.X,0.05),math.max(spec.size.Y,0.05),math.max(spec.size.Z,0.05))
    p.CFrame=spec.cf
    p.Anchored=true; p.CanCollide=collide and not preview; p.CanTouch=false
    p.Material=Enum.Material[spec.material]; p.Color=Color3.fromRGB(spec.color[1],spec.color[2],spec.color[3])
    p.TopSurface=Enum.SurfaceType.Smooth; p.BottomSurface=Enum.SurfaceType.Smooth
    if spec.shape then p.Shape=Enum.PartType[spec.shape] end
    if preview then p.CanQuery=false; p.Archivable=false end
    Materials.apply(p,style)
    p.Parent=parent
    return p
end

-- Builds one generator into `folder`. Returns part count and a list of preview meshes.
function B.entry(path,entry,folder,ctx,budget)
    local o=entry.o
    local styles=entry.styles or {}
    if P.PART_BASED[o.preset] then
        local function make() return P.parts(path,o,budget,ctx.budget or B.MAX_PARTS) end
        -- Part specs are pure data; reuse them when the path and options are unchanged.
        local specs
        if ctx.cache and path.key then
            specs=ctx.cache:memo(path.key.."|"..Json.encode(o),make)
            assert(#specs&lt;=budget,"Part budget exceeded ("..(ctx.budget or B.MAX_PARTS)..")")
        else specs=make() end
        for _,spec in ipairs(specs) do B.part(folder,spec,o.collide,ctx.preview,styles[spec.name]) end
        return #specs
    elseif o.preset=="Custom" then
        local per=Assets.count(entry.source)
        local ds=G.instances(path,o.spacing,math.max(1,math.floor(budget/per)))
        assert(#ds*per&lt;=budget,"Part budget exceeded ("..(ctx.budget or B.MAX_PARTS)..")")
        for _,d in ipairs(ds) do
            local p,f,_,u=G.frame(path,d)
            p+=Vector3.new(0,o.offset,0)
            local c=Assets.clone(entry.source)
            c.Parent=folder
            c:PivotTo(CFrame.lookAt(p,p+f,u)*CFrame.Angles(0,math.rad(o.yaw),0)*CFrame.Angles(0,0,math.rad(o.roll)))
            Assets.configure(c,o.collide,ctx.preview)
        end
        return #ds*per
    end
    assert(budget&gt;=1,"No budget left for base mesh")
    if not ctx.preview then assert(ctx.allowUpload,"Authorize mesh uploads before Generate") end
    if o.preset=="Extrude" then
        assert(#Extrude.plan(path,o).chunks&lt;=budget,"No budget left for base mesh")
        local parts,meshes=Extrude.build(path,o,entry.source,ctx.preview,ctx.canContinue,styles.ExtrudedMesh)
        for _,part in ipairs(parts) do part.Parent=folder end
        return #parts,meshes
    end
    Assets.count(entry.source)
    local part,mesh=Deform.build(entry.source,path,o,ctx.canContinue,ctx.preview)
    part.Parent=folder
    return 1,mesh and {mesh} or {}
end

-- Parts a mesh generator will create, checked before anything is built.
function B.meshParts(path,o)
    if o.preset=="Extrude" then return #Extrude.plan(path,o).chunks end
    return 1
end

-- Builds every enabled generator. ctx = {preview, allowUpload, canContinue, budget}.
-- Returns the output folder, part count and a list of preview EditableMeshes.
function B.stack(path,entries,ctx)
    local budget=ctx.budget or B.MAX_PARTS
    entries=table.clone(entries) -- junction cuts replace entries; never the caller's list
    local output=Instance.new("Folder"); output.Name="Generators"
    local meshes={}
    local count=0
    local ok,err=pcall(function()
        local order={}
        for i,entry in ipairs(entries) do
            if entry.enabled~=false then order[#order+1]=i end
        end
        -- Mesh generators last: nothing is uploaded unless every other generator fits.
        table.sort(order,function(a,b)
            local ma,mb=P.MESH[entries[a].o.preset] and 1 or 0,P.MESH[entries[b].o.preset] and 1 or 0
            if ma~=mb then return ma&lt;mb end
            return a&lt;b
        end)
        if not ctx.preview and not ctx.allowUpload then
            for _,i in ipairs(order) do assert(not P.MESH[entries[i].o.preset],"Authorize mesh uploads before Generate") end
        end
        -- Plan every mesh first: profile/budget errors surface before any upload.
        local meshCount=0
        local need={}
        for _,i in ipairs(order) do
            if P.MESH[entries[i].o.preset] then need[i]=B.meshParts(path,entries[i].o); meshCount+=need[i] end
        end
        -- Junctions: roads leave a gap that one pad per crossing fills.
        local junctions=ctx.junctions or {}
        local padRoad
        if #junctions&gt;0 then
            for _,i in ipairs(order) do
                local e=entries[i]
                if e.o.preset=="Road" then
                    local o=table.clone(e.o); o.cuts=Network.cuts(junctions,path.length)
                    entries[i]={o=o,styles=e.styles,source=e.source,enabled=e.enabled}
                    padRoad=padRoad or entries[i]
                end
            end
        end
        if padRoad then
            local folder=Instance.new("Folder"); folder.Name="Junctions"; folder.Parent=output
            for _,spec in ipairs(Network.padSpecs(junctions,padRoad.o.height,padRoad.o.offset)) do
                B.part(folder,spec,padRoad.o.collide,ctx.preview,padRoad.styles.RoadSurface)
                count+=1
            end
        end
        for _,i in ipairs(order) do
            local entry=entries[i]
            local folder=Instance.new("Folder"); folder.Name=string.format("G%02d_%s",i,entry.o.preset); folder.Parent=output
            -- Keep one part of budget per remaining mesh generator.
            local reserve=P.MESH[entry.o.preset] and 0 or meshCount
            local n,built=B.entry(path,entry,folder,ctx,budget-count-reserve)
            count+=n
            if need[i] then meshCount-=need[i] end
            for _,m in ipairs(built or {}) do meshes[#meshes+1]=m end
            assert(count&lt;=budget,"Part budget exceeded ("..budget..")")
        end
    end)
    if not ok then
        output:Destroy()
        for _,m in ipairs(meshes) do m:Destroy() end
        error(err,0)
    end
    return output,count,meshes
end
return B
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">Persist</string><ProtectedString name="Source">-- Saved path data (PathData folder) for generated models.
-- Format 2 stores a generator stack; format 1 (v0.1–v0.5) stored one generator
-- as attributes on PathData and is still read.
local P=require(script.Parent.Presets)
local Layers=require(script.Parent.Layers)
local Json=require(script.Parent.Json)
local S={FORMAT=2,MAX_GENERATORS=8,MAX_POINTS=128}
local OPTION_KEYS={"preset","profile","fidelity","collide"}
for k in pairs(P.NUMBERS) do OPTION_KEYS[#OPTION_KEYS+1]=k end
table.sort(OPTION_KEYS)
S.OPTION_KEYS=OPTION_KEYS

local function decodeStyles(text)
    if type(text)~="string" or text=="" then return {} end
    local ok,v=pcall(Json.decode,text)
    return ok and type(v)=="table" and v or {}
end

-- Reads one generator's options from attributes; missing values use defaults.
local function readOptions(get)
    local preset=get("preset")
    assert(P.isPreset(preset),"Unknown preset")
    local o=P.options(preset)
    for k,spec in pairs(P.NUMBERS) do
        local v=get(k)
        if type(v)=="number" and v==v and v&gt;=spec[1] and v&lt;=spec[2] then o[k]=v end
    end
    local profile=get("profile"); if type(profile)=="string" and profile~="" then o.profile=profile end
    local fidelity=get("fidelity"); if table.find(P.FIDELITY,fidelity) then o.fidelity=fidelity end
    local collide=get("collide"); if type(collide)=="boolean" then o.collide=collide end
    return P.validate(o)
end
S.readOptions=readOptions

function S.write(meta,state,pivot)
    meta:SetAttribute("Format",S.FORMAT)
    meta:SetAttribute("smooth",state.smooth)
    meta:SetAttribute("junctions",state.junctions==true)
    meta:SetAttribute("PointCount",#state.points)
    meta:SetAttribute("CoordinateSpace","Local")
    for i,pos in ipairs(state.points) do
        local v=Instance.new("Vector3Value"); v.Name=string.format("P%03d",i); v.Value=pivot:PointToObjectSpace(pos); v.Parent=meta
    end
    assert(#state.entries&gt;=1 and #state.entries&lt;=S.MAX_GENERATORS,"A path needs 1–8 generators")
    local folder=Instance.new("Folder"); folder.Name="Generators"; folder.Parent=meta
    for i,entry in ipairs(state.entries) do
        local ref=Instance.new("ObjectValue"); ref.Name=string.format("G%02d",i); ref.Value=entry.source
        for _,k in ipairs(OPTION_KEYS) do ref:SetAttribute(k,entry.o[k]) end
        ref:SetAttribute("enabled",entry.enabled~=false)
        ref:SetAttribute("materialStyles",Json.encode(entry.styles or {}))
        ref.Parent=folder
    end
    Layers.write(meta,state.layers or {})
end

function S.read(meta,pivot)
    local n=meta:GetAttribute("PointCount")
    assert(type(n)=="number" and n&gt;=2 and n&lt;=S.MAX_POINTS,"Invalid saved point count")
    local localSpace=meta:GetAttribute("CoordinateSpace")=="Local"
    local points={}
    for i=1,n do
        local v=meta:FindFirstChild(string.format("P%03d",i))
        assert(v and v:IsA("Vector3Value"),"Missing control point")
        points[i]=localSpace and pivot:PointToWorldSpace(v.Value) or v.Value
    end
    local entries={}
    local folder=meta:FindFirstChild("Generators")
    if folder then
        local children=folder:GetChildren()
        table.sort(children,function(a,b) return a.Name&lt;b.Name end)
        assert(#children&gt;=1 and #children&lt;=S.MAX_GENERATORS,"A path needs 1–8 generators")
        for _,ref in ipairs(children) do
            assert(ref:IsA("ObjectValue"),"Invalid saved generator")
            local o=readOptions(function(k) return ref:GetAttribute(k) end)
            entries[#entries+1]={o=o,source=ref.Value,enabled=ref:GetAttribute("enabled")~=false,styles=decodeStyles(ref:GetAttribute("materialStyles"))}
        end
    else
        -- Format 1: one generator stored directly on PathData.
        local o=readOptions(function(k) return meta:GetAttribute(k) end)
        local ref=meta:FindFirstChild("Asset")
        local source=ref and ref:IsA("ObjectValue") and ref.Value or nil
        entries[1]={o=o,source=source,enabled=true,styles=decodeStyles(meta:GetAttribute("materialStyles"))}
    end
    return {points=points,smooth=meta:GetAttribute("smooth")==true,entries=entries,layers=Layers.read(meta),
        junctions=meta:GetAttribute("junctions")==true}
end
return S
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">Ui</string><ProtectedString name="Source">-- Widget building helpers: tabbed sections, labels, buttons, button rows, inputs.
local U={}
U.C={bg=Color3.fromRGB(24,28,34),panel=Color3.fromRGB(38,44,52),text=Color3.fromRGB(232,237,242),muted=Color3.fromRGB(157,170,185),accent=Color3.fromRGB(36,126,146),error=Color3.fromRGB(255,147,139)}
function U.make(class,parent,props)
    local o=Instance.new(class)
    for k,v in pairs(props or {}) do o[k]=v end
    o.Parent=parent
    return o
end
-- T translates text; isBusy blocks button callbacks while a build runs.
function U.new(widget,T,isBusy)
    local C=U.C
    local make=U.make
    local ui={fields={},order=0,section=nil,active=nil,items={},tabs={}}
    ui.scroll=make("ScrollingFrame",widget,{Size=UDim2.fromScale(1,1),BackgroundColor3=C.bg,BorderSizePixel=0,AutomaticCanvasSize=Enum.AutomaticSize.Y,CanvasSize=UDim2.new(),ScrollBarThickness=5})
    make("UIPadding",ui.scroll,{PaddingTop=UDim.new(0,12),PaddingBottom=UDim.new(0,12),PaddingLeft=UDim.new(0,12),PaddingRight=UDim.new(0,12)})
    make("UIListLayout",ui.scroll,{Padding=UDim.new(0,6),SortOrder=Enum.SortOrder.LayoutOrder})
    function ui.select(name)
        ui.active=name
        for section,items in pairs(ui.items) do
            for _,obj in ipairs(items) do obj.Visible=section==name end
        end
        for section,b in pairs(ui.tabs) do b.BackgroundColor3=section==name and C.accent or C.panel end
    end
    function ui.item(class,props)
        ui.order+=1
        props.LayoutOrder=ui.order
        local obj=make(class,ui.scroll,props)
        if ui.section then
            ui.items[ui.section]=ui.items[ui.section] or {}
            table.insert(ui.items[ui.section],obj); obj.Visible=ui.section==ui.active
        end
        return obj
    end
    function ui.label(text,h,color)
        return ui.item("TextLabel",{Size=UDim2.new(1,0,0,h or 22),BackgroundTransparency=1,Text=T(text),TextColor3=color or C.text,Font=Enum.Font.Gotham,TextSize=13,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left})
    end
    local function styleButton(b)
        make("UICorner",b,{CornerRadius=UDim.new(0,5)})
        return b
    end
    function ui.button(text,fn,accent)
        local b=styleButton(ui.item("TextButton",{Size=UDim2.new(1,0,0,32),BackgroundColor3=accent and C.accent or C.panel,BorderSizePixel=0,Text=T(text),TextColor3=C.text,Font=Enum.Font.GothamMedium,TextSize=13,TextWrapped=true,AutoButtonColor=true}))
        b.Activated:Connect(function() if not isBusy() then fn() end end)
        return b
    end
    -- Several equal-width buttons on one line: {{text, fn}, ...}. Returns the buttons.
    function ui.row(list,height)
        local frame=ui.item("Frame",{Size=UDim2.new(1,0,0,height or 30),BackgroundTransparency=1})
        local out={}
        for i,entry in ipairs(list) do
            local b=styleButton(make("TextButton",frame,{Position=UDim2.new((i-1)/#list,2,0,0),Size=UDim2.new(1/#list,-4,1,0),Text=T(entry[1]),TextSize=12,TextWrapped=true,Font=Enum.Font.GothamMedium,TextColor3=C.text,BackgroundColor3=C.panel,BorderSizePixel=0}))
            b.Activated:Connect(function() if not isBusy() then entry[2]() end end)
            out[i]=b
        end
        return out
    end
    function ui.input(key,title,value)
        local row=ui.item("Frame",{Size=UDim2.new(1,0,0,30),BackgroundTransparency=1})
        make("TextLabel",row,{Size=UDim2.fromScale(0.59,1),BackgroundTransparency=1,Text=T(title),TextColor3=C.muted,Font=Enum.Font.Gotham,TextSize=12,TextWrapped=true,TextXAlignment=Enum.TextXAlignment.Left})
        local box=make("TextBox",row,{Position=UDim2.fromScale(0.6,0),Size=UDim2.fromScale(0.4,1),BackgroundColor3=C.panel,BorderSizePixel=0,Text=tostring(value),TextColor3=C.text,Font=Enum.Font.Gotham,TextSize=13,ClearTextOnFocus=false})
        make("UICorner",box,{CornerRadius=UDim.new(0,4)})
        ui.fields[key]=box
        return box
    end
    -- Tab bar; each tab shows only the items created after ui.section=name.
    function ui.tabBar(names,onSelect)
        local bar=ui.item("Frame",{Size=UDim2.new(1,0,0,32),BackgroundTransparency=1})
        for i,name in ipairs(names) do
            local b=styleButton(make("TextButton",bar,{Position=UDim2.new((i-1)/#names,2,0,0),Size=UDim2.new(1/#names,-4,1,0),Text=T(name),TextSize=12,Font=Enum.Font.GothamMedium,TextColor3=C.text,BackgroundColor3=C.panel,BorderSizePixel=0}))
            ui.tabs[name]=b
            b.Activated:Connect(function() ui.select(name); ui.scroll.CanvasPosition=Vector2.zero; if onSelect then onSelect(name) end end)
        end
        ui.active=names[1]
        return bar
    end
    return ui
end
return U
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">Cache</string><ProtectedString name="Source">-- Small least-recently-used cache for pure results (paths, part specs).
-- Keys are strings, usually Json.encode of every input that affects the result.
local Json=require(script.Parent.Json)
local C={}
C.__index=C
function C.new(max)
    return setmetatable({max=max or 16,map={},order={},hits=0,misses=0},C)
end
local function touch(self,key)
    local order=self.order
    local i=table.find(order,key)
    if i then table.remove(order,i) end
    order[#order+1]=key
end
function C:get(key)
    local v=self.map[key]
    if v~=nil then self.hits+=1; touch(self,key) else self.misses+=1 end
    return v
end
function C:put(key,v)
    self.map[key]=v; touch(self,key)
    while #self.order&gt;self.max do
        local old=table.remove(self.order,1); self.map[old]=nil
    end
    return v
end
-- Returns the cached value for key, computing it with fn() on a miss.
-- Errors are not cached.
function C:memo(key,fn)
    local v=self:get(key)
    if v==nil then v=self:put(key,fn()) end
    return v
end
function C:clear() self.map={}; self.order={} end
-- Stable key for a list of Vector3 points plus extra settings.
function C.pointsKey(points,extra)
    local flat={}
    for i,p in ipairs(points) do flat[i]={p.X,p.Y,p.Z} end
    return Json.encode({p=flat,x=extra})
end
return C
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">Library</string><ProtectedString name="Source">-- Material presets, a per-place material/asset library and reusable recipes.
-- Everything is stored in ServerStorage.PathForgeLibrary so it saves with the place.
local P=require(script.Parent.Presets)
local Layers=require(script.Parent.Layers)
local Assets=require(script.Parent.Assets)
local Json=require(script.Parent.Json)
local L={RECIPE_FORMAT=1,MAX_ITEMS=200}

local function style(material,rgb,extra)
    local s={material=material,variant="",color={rgb[1]/255,rgb[2]/255,rgb[3]/255},transparency=0,reflectance=0,textures={}}
    for k,v in pairs(extra or {}) do s[k]=v end
    return s
end
-- Built-in material presets (names are English keys, translated in the UI).
L.BUILTIN={
    {"Asphalt (dark)",style("Asphalt",{54,58,63})},
    {"Asphalt (worn)",style("Asphalt",{96,98,100})},
    {"Concrete (light)",style("Concrete",{170,170,165})},
    {"Concrete (dark)",style("Concrete",{99,99,95})},
    {"Pavement",style("Pavement",{140,138,132})},
    {"Brick (red)",style("Brick",{141,72,55})},
    {"Cobblestone",style("Cobblestone",{120,115,108})},
    {"Wood (oak)",style("Wood",{150,110,70})},
    {"Wood (dark)",style("Wood",{91,67,46})},
    {"Wood planks",style("WoodPlanks",{160,120,80})},
    {"Steel",style("Metal",{103,110,119})},
    {"Rusty metal",style("CorrodedMetal",{125,80,55})},
    {"Diamond plate",style("DiamondPlate",{150,155,160})},
    {"Marble (white)",style("Marble",{230,230,225})},
    {"Granite",style("Granite",{110,105,100})},
    {"Glass (clear)",style("Glass",{200,225,235},{transparency=0.5,reflectance=0.2})},
    {"Grass",style("Grass",{90,140,60})},
    {"Sand",style("Sand",{210,190,140})},
    {"Neon (blue)",style("Neon",{60,160,255})},
    {"Painted line (white)",style("SmoothPlastic",{220,220,210})},
    {"Painted line (yellow)",style("SmoothPlastic",{233,184,62})},
}

function L.validName(name)
    assert(type(name)=="string","Enter a library name")
    name=name:match("^%s*(.-)%s*$")
    assert(#name&gt;=1 and #name&lt;=50,"Library names must be 1–50 characters")
    assert(not name:find("[%c/\\]"),"Library names cannot contain slashes")
    return name
end

-- Validates a material style table (shape written by Materials.capture).
function L.validStyle(s)
    assert(type(s)=="table" and type(s.material)=="string" and Enum.Material[s.material],"Invalid material style")
    assert(type(s.color)=="table" and #s.color==3,"Invalid material style")
    for _,c in ipairs(s.color) do assert(type(c)=="number" and c&gt;=0 and c&lt;=1,"Invalid material style") end
    s.variant=type(s.variant)=="string" and s.variant or ""
    s.transparency=math.clamp(tonumber(s.transparency) or 0,0,1)
    s.reflectance=math.clamp(tonumber(s.reflectance) or 0,0,1)
    s.textures=type(s.textures)=="table" and s.textures or {}
    return s
end

-- Library folders ------------------------------------------------------------
-- folder(storage, create): returns ServerStorage.PathForgeLibrary/&lt;kind&gt;, optionally creating it.
function L.folder(storage,kind,create)
    local root=storage:FindFirstChild("PathForgeLibrary")
    if not root then
        if not create then return nil end
        root=Instance.new("Folder"); root.Name="PathForgeLibrary"; root.Parent=storage
    end
    assert(root:IsA("Folder"),"PathForgeLibrary must be a Folder")
    local f=root:FindFirstChild(kind)
    if not f then
        if not create then return nil end
        f=Instance.new("Folder"); f.Name=kind; f.Parent=root
    end
    assert(f:IsA("Folder"),"PathForgeLibrary must be a Folder")
    return f
end
local function sortedChildren(folder)
    if not folder then return {} end
    local list=folder:GetChildren()
    table.sort(list,function(a,b) return a.Name:lower()&lt;b.Name:lower() end)
    return list
end

-- Materials: built-ins first, then the place's saved materials ("My: name").
function L.materials(storage)
    local out={}
    for _,b in ipairs(L.BUILTIN) do out[#out+1]={name=b[1],style=b[2],builtin=true} end
    for _,v in ipairs(sortedChildren(L.folder(storage,"Materials",false))) do
        if v:IsA("StringValue") then
            local ok,s=pcall(function() return L.validStyle(Json.decode(v.Value)) end)
            if ok then out[#out+1]={name=v.Name,style=s,builtin=false} end
        end
    end
    return out
end
function L.saveMaterial(storage,name,s)
    name=L.validName(name)
    local folder=L.folder(storage,"Materials",true)
    assert(#folder:GetChildren()&lt;L.MAX_ITEMS,"Library is full (200 items)")
    local v=folder:FindFirstChild(name) or Instance.new("StringValue")
    v.Name=name; v.Value=Json.encode(L.validStyle(table.clone(s))); v.Parent=folder
    return v
end

-- Assets: valid Models/BaseParts stored in the library (and older generation snapshots).
function L.assets(storage)
    local out={}
    local seen={}
    local function scan(folder)
        for _,a in ipairs(sortedChildren(folder)) do
            if not seen[a] and pcall(Assets.count,a) then seen[a]=true; out[#out+1]=a end
        end
    end
    scan(L.folder(storage,"Assets",false))
    scan(storage:FindFirstChild("PathForgeAssets"))
    return out
end
function L.addAsset(storage,source,name)
    Assets.count(source)
    local folder=L.folder(storage,"Assets",true)
    assert(#folder:GetChildren()&lt;L.MAX_ITEMS,"Library is full (200 items)")
    local c=Assets.clone(source)
    c.Name=L.validName(name or source.Name)
    c.Parent=folder
    return c
end

-- Recipes: generator stack + layer settings (+ source references) without points.
function L.encodeRecipe(entries,layers,smooth)
    assert(#entries&gt;=1,"A path needs at least one generator")
    local data={format=L.RECIPE_FORMAT,smooth=smooth,generators={},layers={}}
    local refs={}
    for i,e in ipairs(entries) do
        local o=P.validate(table.clone(e.o))
        data.generators[i]={o=o,styles=e.styles or {},enabled=e.enabled~=false}
        if e.source then refs[string.format("G%02d",i)]=e.source end
    end
    for i,l in ipairs(layers or {}) do
        Layers.validate(l)
        data.layers[i]={spacing=l.spacing,side=l.side,height=l.height,yaw=l.yaw,roll=l.roll,enabled=l.enabled,collide=l.collide}
        if l.source then refs[string.format("L%02d",i)]=l.source end
    end
    return Json.encode(data),refs
end
function L.decodeRecipe(text,refs)
    local data=Json.decode(text)
    assert(type(data)=="table" and data.format==L.RECIPE_FORMAT,"Unsupported recipe format")
    assert(type(data.generators)=="table" and #data.generators&gt;=1 and #data.generators&lt;=8,"A path needs 1–8 generators")
    local entries,layers={},{}
    for i,g in ipairs(data.generators) do
        local o=P.options(g.o and g.o.preset)
        for k,v in pairs(g.o) do o[k]=v end
        local styles={}
        for slot,s in pairs(type(g.styles)=="table" and g.styles or {}) do styles[slot]=L.validStyle(s) end
        entries[i]={o=P.validate(o),styles=styles,enabled=g.enabled~=false,source=refs[string.format("G%02d",i)]}
    end
    assert(#(data.layers or {})&lt;=Layers.MAX_LAYERS,"Maximum 12 repeat layers")
    for i,l in ipairs(data.layers or {}) do
        local layer=table.clone(l)
        layer.source=refs[string.format("L%02d",i)]
        Layers.validate(layer)
        if not layer.source then layer.enabled=false end
        layers[i]=layer
    end
    return entries,layers,data.smooth~=false
end
function L.saveRecipe(storage,name,entries,layers,smooth)
    name=L.validName(name)
    local text,refs=L.encodeRecipe(entries,layers,smooth)
    local folder=L.folder(storage,"Recipes",true)
    assert(#folder:GetChildren()&lt;L.MAX_ITEMS,"Library is full (200 items)")
    local old=folder:FindFirstChild(name)
    if old then old:Destroy() end
    local recipe=Instance.new("Configuration"); recipe.Name=name
    local v=Instance.new("StringValue"); v.Name="Data"; v.Value=text; v.Parent=recipe
    for key,inst in pairs(refs) do
        local ref=Instance.new("ObjectValue"); ref.Name=key; ref.Value=inst; ref.Parent=recipe
    end
    recipe.Parent=folder
    return recipe
end
function L.recipes(storage)
    local out={}
    for _,r in ipairs(sortedChildren(L.folder(storage,"Recipes",false))) do
        if r:FindFirstChild("Data") then out[#out+1]=r end
    end
    return out
end
function L.loadRecipe(recipe)
    local data=recipe:FindFirstChild("Data")
    assert(data and data:IsA("StringValue"),"Recipe data is missing")
    local refs={}
    for _,c in ipairs(recipe:GetChildren()) do
        if c:IsA("ObjectValue") and c.Value then refs[c.Name]=c.Value end
    end
    return L.decodeRecipe(data.Value,refs)
end
return L
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">Network</string><ProtectedString name="Source">-- Path networks: snapping branch ends onto other paths and finding where paths
-- cross, so roads can get a junction pad instead of overlapping surfaces.
local G=require(script.Parent.Geometry)
local N={}
local EPS=1e-6

-- Nearest point on a sampled path. Returns distance along path, position, gap.
function N.project(path,q)
    local ps,ds=path.positions,path.distances
    local best,bestD,bestP=math.huge,0,ps[1]
    for i=1,#ps-1 do
        local a,b=ps[i],ps[i+1]
        local ab=b-a
        local len2=ab:Dot(ab)
        local t=len2&gt;EPS and math.clamp((q-a):Dot(ab)/len2,0,1) or 0
        local p=a+ab*t
        local gap=(q-p).Magnitude
        if gap&lt;best then best=gap; bestP=p; bestD=ds[i]+(ds[i+1]-ds[i])*t end
    end
    return bestD,bestP,best
end

-- Moves the first/last draft point onto the nearest other path within radius.
-- Returns new points and how many ends were snapped.
function N.snapEnds(points,paths,radius)
    assert(radius&gt;0,"Snap radius must be positive")
    local out=table.clone(points)
    local snapped=0
    for _,i in ipairs(#out&gt;=2 and {1,#out} or {}) do
        local bestGap,bestP=radius,nil
        for _,path in ipairs(paths) do
            local _,p,gap=N.project(path,out[i])
            if gap&lt;=bestGap then bestGap=gap; bestP=p end
        end
        if bestP then out[i]=bestP; snapped+=1 end
    end
    return out,snapped
end

-- 2D (XZ) intersection of segments ab and cd; returns ta, tc or nil.
local function cross2(ax,az,bx,bz) return ax*bz-az*bx end
local function intersect(a,b,c,d)
    local rx,rz=b.X-a.X,b.Z-a.Z
    local sx,sz=d.X-c.X,d.Z-c.Z
    local den=cross2(rx,rz,sx,sz)
    if math.abs(den)&lt;EPS then return nil end
    local qx,qz=c.X-a.X,c.Z-a.Z
    local t=cross2(qx,qz,sx,sz)/den
    local u=cross2(qx,qz,rx,rz)/den
    if t&lt;-EPS or t&gt;1+EPS or u&lt;-EPS or u&gt;1+EPS then return nil end
    return t,u
end

-- Where path A meets path B in plan view (crossings and T-junction ends).
-- maxGap limits the vertical difference (bridges over roads are not junctions).
-- Returns a list of {da, db, position}, sorted along A, duplicates merged.
function N.crossings(a,b,maxGap)
    maxGap=maxGap or 2
    local out={}
    local pa,da,pb,db=a.positions,a.distances,b.positions,b.distances
    for i=1,#pa-1 do
        for j=1,#pb-1 do
            local t,u=intersect(pa[i],pa[i+1],pb[j],pb[j+1])
            if t then
                local qa=pa[i]+(pa[i+1]-pa[i])*t
                local qb=pb[j]+(pb[j+1]-pb[j])*u
                if math.abs(qa.Y-qb.Y)&lt;=maxGap then
                    out[#out+1]={da=da[i]+(da[i+1]-da[i])*t,db=db[j]+(db[j+1]-db[j])*u,position=(qa+qb)/2}
                end
            end
        end
    end
    -- Ends of A that touch B (a snapped branch) count even without a strict crossing.
    for _,d in ipairs({0,a.length}) do
        local p=G.at(a,d)
        local dbHit,q,gap=N.project(b,p)
        if gap&lt;=0.05 and math.abs(p.Y-q.Y)&lt;=maxGap then out[#out+1]={da=d,db=dbHit,position=q} end
    end
    table.sort(out,function(x,y) return x.da&lt;y.da end)
    local merged={}
    for _,c in ipairs(out) do
        local last=merged[#merged]
        if not last or c.da-last.da&gt;0.5 then merged[#merged+1]=c end
    end
    return merged
end

-- Junction pads for this path against other paths.
-- others: list of {path, width}; width is the other road's width.
-- Returns {d, position, forward, up, size, half} for each junction.
function N.junctions(path,width,others,maxGap)
    local out={}
    for _,other in ipairs(others) do
        for _,c in ipairs(N.crossings(path,other.path,maxGap)) do
            local _,fa,_,ua=G.frame(path,c.da)
            local _,fb=G.frame(other.path,c.db)
            -- Narrow crossing angles need a longer pad; capped at 3x.
            local sin=math.max(math.abs(fa:Cross(fb).Magnitude),1/3)
            local w=math.max(width,other.width)
            local len=math.min(w/sin,w*3)
            out[#out+1]={d=c.da,position=c.position,forward=fa,up=ua,size=Vector3.new(w,0,len),half=len/2}
        end
    end
    table.sort(out,function(x,y) return x.d&lt;y.d end)
    return out
end

-- Distance ranges along the path that a road should leave to the junction pad.
function N.cuts(junctions,length)
    local cuts={}
    for _,j in ipairs(junctions) do
        cuts[#cuts+1]={math.max(0,j.d-j.half),math.min(length,j.d+j.half)}
    end
    return cuts
end

-- Part specs for the pads: flat asphalt slabs whose top sits on the road surface.
function N.padSpecs(junctions,height,offset)
    local specs={}
    for _,j in ipairs(junctions) do
        local h=math.max(height,0.05)
        local top=j.position+Vector3.new(0,offset+0.01,0)
        local center=top-j.up*(h/2)
        specs[#specs+1]={name="Junction",cf=CFrame.lookAt(center,center+j.forward,j.up),
            size=Vector3.new(j.size.X,h,j.size.Z),material="Asphalt",color={54,58,63}}
    end
    return specs
end
return N
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">Terrain</string><ProtectedString name="Source">-- Terrain-aware paths: draping points onto the ground, and planning terrain
-- fill (support under the path) and carve (clear space above it).
-- Pure planning; the plugin applies blocks with Terrain:FillBlock.
local G=require(script.Parent.Geometry)
local T={MAX_BLOCKS=2000}
T.MATERIALS={"Ground","Grass","Rock","Asphalt","Sand","Mud","Slate","Concrete"}

-- heightAt(x, z) -&gt; ground Y or nil. Points without ground keep their height.
function T.drape(points,heightAt,offset)
    local out,hit={},0
    for i,p in ipairs(points) do
        local y=heightAt(p.X,p.Z)
        if y then out[i]=Vector3.new(p.X,y+offset,p.Z); hit+=1 else out[i]=p end
    end
    return out,hit
end

-- Resamples the path every `spacing` studs (keeping both ends) and drapes the
-- new points, so the path follows hills between the original points.
function T.resample(path,spacing,heightAt,offset,maxPoints)
    assert(spacing&gt;0,"Resample spacing must be positive")
    local n=math.max(1,math.ceil(path.length/spacing))
    assert(n+1&lt;=maxPoints,"Too many points: increase resample spacing")
    local pts={}
    for i=0,n do pts[#pts+1]=G.at(path,path.length*i/n) end
    return T.drape(pts,heightAt,offset)
end

-- Plans terrain blocks along the path. o = {width, shoulder, depth, clear, step, offset, sink}.
-- The fill top sits `sink` studs below the path so terrain does not poke through roads.
-- Each block follows the path frame; fill sits below the path surface,
-- carve (air) above it. Returns {fill={...}, carve={...}} of {cf, size}.
function T.plan(path,o)
    assert(o.width&gt;0 and o.depth&gt;=0 and o.clear&gt;=0,"Invalid terrain settings")
    local ds=G.segments(path,o.step,T.MAX_BLOCKS)
    local fill,carve={},{}
    local w=o.width+2*o.shoulder
    for i=1,#ds-1 do
        local a,_,_,ua=G.frame(path,ds[i]); local b,_,_,ub=G.frame(path,ds[i+1])
        local up=(ua+ub).Unit
        local len=(b-a).Magnitude
        if len&gt;1e-4 then
            local mid=(a+b)/2+Vector3.new(0,o.offset,0)
            -- Terrain voxels are 4 studs; overlap blocks so curves leave no gaps.
            local along=len+2
            local look=CFrame.lookAt(mid,mid+(b-a),up)
            if o.depth&gt;0 then fill[#fill+1]={cf=look*CFrame.new(0,-(o.sink or 0.5)-o.depth/2,0),size=Vector3.new(w,o.depth,along)} end
            if o.clear&gt;0 then carve[#carve+1]={cf=look*CFrame.new(0,o.clear/2,0),size=Vector3.new(w,o.clear,along)} end
        end
    end
    return {fill=fill,carve=carve}
end
return T
</ProtectedString></Properties></Item></Item></roblox>