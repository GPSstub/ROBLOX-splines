<Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Geometry</string><ProtectedString name="Source">-- Pure path math; uses only Roblox Vector3 arithmetic.
local G = {}
local EPS = 1e-5
local function mix(a,b,t) return a + (b-a)*t end
local function blend(a,b,ta,tb,t) return mix(a,b,(t-ta)/(tb-ta)) end
local function span(a,b) return math.max((b-a).Magnitude^0.5, 0.01) end
-- Centripetal Catmull-Rom; reflected endpoints preserve endpoint tangents.
function G.curve(p0,p1,p2,p3,u)
    local t0=0
    local t1=span(p0,p1)
    local t2=t1+span(p1,p2)
    local t3=t2+span(p2,p3)
    local t=t1+(t2-t1)*u
    local a1=blend(p0,p1,t0,t1,t)
    local a2=blend(p1,p2,t1,t2,t)
    local a3=blend(p2,p3,t2,t3,t)
    local b1=blend(a1,a2,t0,t2,t)
    local b2=blend(a2,a3,t1,t3,t)
    return blend(b1,b2,t1,t2,t)
end
function G.path(points, smooth)
    local clean={}
    for _,p in ipairs(points) do
        if #clean==0 or (p-clean[#clean]).Magnitude&gt;0.001 then clean[#clean+1]=p end
    end
    assert(#clean&gt;=2,"Add at least two distinct control points")
    assert(#clean&lt;=128,"Maximum 128 control points")
    local out={clean[1]}
    local distances={0}
    local total=0
    for i=1,#clean-1 do
        local a,b=clean[i],clean[i+1]
        local p0=clean[i-1] or (a+(a-b))
        local p3=clean[i+2] or (b+(b-a))
        local n=smooth and math.min(160,math.max(16,math.ceil((b-a).Magnitude/1.0))) or 1
        for j=1,n do
            local q= j==n and b or (smooth and G.curve(p0,a,b,p3,j/n) or mix(a,b,j/n))
            local d=(q-out[#out]).Magnitude
            if d&gt;EPS then
                total=total+d
                out[#out+1]=q
                distances[#distances+1]=total
            end
        end
    end
    assert(total&gt;EPS,"Path is too short")
    return {positions=out, distances=distances, length=total}
end
function G.at(path,d)
    d=math.max(0,math.min(path.length,d))
    local ds,ps=path.distances,path.positions
    local lo,hi=1,#ds
    while hi-lo&gt;1 do
        local m=math.floor((lo+hi)/2)
        if ds[m]&lt;=d then lo=m else hi=m end
    end
    return mix(ps[lo],ps[hi],(d-ds[lo])/(ds[hi]-ds[lo]))
end
local function tangent(path,d)
    local delta=math.min(0.25,path.length/4)
    local t=G.at(path,d+delta)-G.at(path,d-delta)
    if t.Magnitude&lt;EPS then t=G.at(path,d+delta)-G.at(path,d) end
    if t.Magnitude&lt;EPS then t=G.at(path,d)-G.at(path,d-delta) end
    return t.Magnitude&lt;EPS and Vector3.new(0,0,-1) or t.Unit
end
local function initialRight(f)
    local up=math.abs(f.Y)&gt;0.995 and Vector3.new(0,0,1) or Vector3.yAxis
    return f:Cross(up).Unit
end
-- Minimal rotation transporting the previous frame to the next tangent.
local function transport(r,a,b)
    local cross=a:Cross(b)
    local sin=cross.Magnitude
    local cos=math.clamp(a:Dot(b),-1,1)
    if sin&gt;EPS then
        local axis=cross/sin
        r=r*cos+axis:Cross(r)*sin+axis*(axis:Dot(r)*(1-cos))
    end
    r=r-b*r:Dot(b)
    return r.Magnitude&gt;EPS and r.Unit or initialRight(b)
end
local function frames(path)
    if path.frames then return path.frames end
    local cache={}
    for i,d in ipairs(path.distances) do
        local f=tangent(path,d)
        local r=i==1 and initialRight(f) or transport(cache[i-1].r,cache[i-1].f,f)
        cache[i]={f=f,r=r}
    end
    path.frames=cache
    return cache
end
function G.frame(path,d)
    d=math.clamp(d,0,path.length)
    local cache=frames(path)
    local lo,hi=1,#cache
    while hi-lo&gt;1 do
        local m=math.floor((lo+hi)/2)
        if path.distances[m]&lt;=d then lo=m else hi=m end
    end
    local f=tangent(path,d)
    local r=transport(cache[lo].r,cache[lo].f,f)
    return G.at(path,d),f,r,r:Cross(f).Unit
end
-- Continuous geometry includes both endpoints and distributes segment length evenly.
function G.segments(path,step,limit)
    assert(step&gt;0,"Segment length must be positive")
    local n=math.max(1,math.ceil(path.length/step))
    assert(n&lt;=limit,"Too many segments: increase segment length or shorten path")
    local ds={}
    for i=0,n do ds[#ds+1]=path.length*i/n end
    -- Preserve polyline corners even when a uniform sample would skip over them.
    -- The caller marks linear paths; smooth samples are already sufficiently dense.
    if path.linear then
        for i=2,#path.distances-1 do ds[#ds+1]=path.distances[i] end
        table.sort(ds)
        local unique={ds[1]}
        for i=2,#ds do if ds[i]-unique[#unique]&gt;EPS then unique[#unique+1]=ds[i] end end
        ds=unique
    end
    assert(#ds-1&lt;=limit,"Too many segments")
    return ds
end
-- Repeated objects use exact spacing; centered placement avoids clipped endpoints.
function G.instances(path,spacing,limit)
    assert(spacing&gt;0,"Spacing must be positive")
    local n=math.max(1,math.floor(path.length/spacing)+1)
    assert(n&lt;=limit,"Too many assets: increase spacing or shorten path")
    local start=(path.length-(n-1)*spacing)/2
    local ds={}
    for i=0,n-1 do ds[#ds+1]=start+i*spacing end
    return ds
end
-- Adaptive samples refine by chord error and tangent angle. Explicit polyline
-- corners remain present; refinement is bounded, so difficult paths fail safely.
function G.adaptive(path,step,maxAngle,tolerance,limit)
    assert(step&gt;0 and maxAngle&gt;0 and tolerance&gt;0 and limit&gt;=1,"Invalid adaptive settings")
    local base=G.segments(path,step,limit)
    local out={base[1]}
    local function split(a,b,depth)
        local pa,pb=G.at(path,a),G.at(path,b)
        local mid=(a+b)/2
        local pm=G.at(path,mid)
        local chordError=(pm-(pa+pb)/2).Magnitude
        local va,vb=pm-pa,pb-pm
        local angle=0
        if va.Magnitude&gt;EPS and vb.Magnitude&gt;EPS then angle=math.acos(math.clamp(va.Unit:Dot(vb.Unit),-1,1)) end
        if not path.linear and (chordError&gt;tolerance or angle&gt;maxAngle) and depth&lt;10 and b-a&gt;0.025 then
            split(a,mid,depth+1); split(mid,b,depth+1)
        else
            assert(#out&lt;=limit,"Adaptive segment budget exceeded")
            out[#out+1]=b
        end
    end
    for i=1,#base-1 do split(base[i],base[i+1],0) end
    return out
end
return G
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Materials</string><ProtectedString name="Source">-- User-defined, serializable material slots. No network calls.
local M={}
local function rgb(c) return {c.R,c.G,c.B} end
local function color(v) return Color3.new(v[1],v[2],v[3]) end
function M.capture(part)
    assert(part and part:IsA("BasePart"),"Select a BasePart with the desired material")
    local result={material=part.Material.Name,variant=part.MaterialVariant,color=rgb(part.Color),
        transparency=part.Transparency,reflectance=part.Reflectance,textures={}}
    for _,t in ipairs(part:GetChildren()) do
        if t:IsA("Texture") or t:IsA("Decal") then
            local x={class=t.ClassName,face=t.Face.Name,texture=t.Texture,color=rgb(t.Color3),transparency=t.Transparency}
            if t:IsA("Texture") then
                x.u=t.StudsPerTileU; x.v=t.StudsPerTileV
                x.ou=t.OffsetStudsU; x.ov=t.OffsetStudsV
            end
            table.insert(result.textures,x)
        end
    end
    return result
end
function M.apply(part,style)
    if not style then return end
    local material=Enum.Material[style.material]
    assert(material,"Invalid material: "..tostring(style.material))
    part.Material=material
    part.MaterialVariant=style.variant or ""
    part.Color=color(style.color)
    part.Transparency=style.transparency or 0
    part.Reflectance=style.reflectance or 0
    for _,t in ipairs(part:GetChildren()) do
        if t:IsA("Decal") then t:Destroy() end
    end
    for _,x in ipairs(style.textures or {}) do
        assert(x.class=="Texture" or x.class=="Decal","Invalid texture class")
        local t=Instance.new(x.class)
        t.Face=Enum.NormalId[x.face]; t.Texture=x.texture
        t.Color3=color(x.color); t.Transparency=x.transparency
        if t:IsA("Texture") then
            t.StudsPerTileU=x.u; t.StudsPerTileV=x.v
            t.OffsetStudsU=x.ou; t.OffsetStudsV=x.ov
        end
        t.Parent=part
    end
end
return M
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">Deform</string><ProtectedString name="Source">-- Explicit asset-backed deformation. Called only after a one-shot user authorization.
local AssetService=game:GetService("AssetService")
local G=require(script.Parent.Geometry)
local O=require(script.Parent.MeshOutput)
local D={}
function D.build(source,path,o,canContinue,preview)
    assert(source and source:IsA("MeshPart"),"Deform requires one static MeshPart")
    assert(not source:FindFirstChildWhichIsA("Bone",true),"Skinned meshes are not supported")
    assert(path.length&lt;=2000,"Deform path limit: 2000 studs")
    local mesh,output
    local ok,result=pcall(function()
        mesh=AssetService:CreateEditableMeshAsync(source.MeshContent)
        assert(mesh,"EditableMesh unavailable (permissions or memory budget)")
        local ids=mesh:GetVertices()
        assert(#ids&gt;=3 and #ids&lt;=60000,"Unsupported vertex count")
        local size=mesh:GetSize()
        local center=mesh:GetCenter()
        assert(size.X&gt;1e-5 and size.Y&gt;=0 and size.Z&gt;1e-5,"Source needs X width and -Z length")
        local scale=Vector3.new(source.Size.X/math.max(size.X,1e-5),source.Size.Y/math.max(size.Y,1e-5),source.Size.Z/math.max(size.Z,1e-5))
        local anchor=G.at(path,0)
        local roll=math.rad(o.roll)
        local co,si=math.cos(roll),math.sin(roll)
        for _,id in ipairs(ids) do
            local v=mesh:GetPosition(id)-center
            local d=math.clamp(0.5-v.Z/size.Z,0,1)*path.length
            local pos,_,right,up=G.frame(path,d)
            local x,y=v.X*scale.X,v.Y*scale.Y
            local world=pos-anchor+right*(x*co-y*si)+up*(x*si+y*co)+Vector3.new(0,o.offset,0)
            mesh:SetPosition(id,world)
        end
        for _,id in ipairs(mesh:GetNormals()) do mesh:ResetNormal(id) end
        output=O.create(mesh,anchor,o,"DeformedMesh",source,preview,canContinue)
        return output
    end)
    if not ok then if output then output:Destroy() end; if mesh then mesh:Destroy() end; error(result,0) end
    if preview then return result,mesh end
    mesh:Destroy()
    return result
end
return D
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">SelfTest</string><ProtectedString name="Source">-- In-Studio math self-tests; no assets, uploads or Workspace edits.
local G=require(script.Parent.Geometry)
local E=require(script.Parent.Extrude)
local L=require(script.Parent.Layers)
local T={}
local function close(a,b,e) assert(math.abs(a-b)&lt;(e or 1e-4),"Expected "..tostring(b)..", got "..tostring(a)) end
function T.run()
    local n=0
    local function test(fn) fn(); n+=1 end
    local V=Vector3.new
    test(function() local p=G.path({V(0,0,0),V(0,0,-20)},true); close(p.length,20); close((G.at(p,0)-V(0,0,0)).Magnitude,0); close((G.at(p,20)-V(0,0,-20)).Magnitude,0) end)
    test(function() local p=G.path({V(0,0,0),V(0,0,0),V(5,0,0)},false); close(p.length,5) end)
    test(function() assert(not pcall(G.path,{V(0,0,0),V(0,0,0)},true)) end)
    test(function() local p=G.path({V(0,0,0),V(0,0,-10)},true); local ds=G.instances(p,3,10); close(ds[1],0.5); close(ds[2]-ds[1],3); close(ds[#ds],9.5) end)
    test(function() local p=G.path({V(0,0,0),V(3,0,0),V(3,0,5)},false); p.linear=true; local ds=G.segments(p,4,10); assert(table.find(ds,3)) end)
    test(function() local p=G.path({V(0,0,0),V(0,10,0),V(3,20,0),V(8,30,0)},true); local last
        for i=0,100 do local _,f,r,u=G.frame(p,p.length*i/100); close(f.Magnitude,1); close(r.Magnitude,1); close(u.Magnitude,1); close(f:Dot(r),0); close(f:Dot(u),0); close(r:Dot(u),0); if last then assert(last:Dot(r)&gt;0,"Frame flip") end; last=r end
    end)
    test(function() local p=G.path({V(0,0,0),V(0,10,0)},true); local _,f,r,u=G.frame(p,5); close(f.Y,1); close(r:Dot(u),0) end)
    test(function() local p=G.path({V(0,0,0),V(100,0,0)},false); assert(not pcall(G.instances,p,1,10)); assert(not pcall(G.segments,p,1,10)) end)
    test(function() local p=G.path({V(0,0,0),V(0,0,-20)},true); local ds=G.adaptive(p,5,0.1,0.01,100); assert(#ds==5); close(ds[#ds],20) end)
    test(function() local p=G.path({V(0,0,0),V(10,0,0),V(10,0,10)},true); local a=G.adaptive(p,10,0.15,0.03,1000); assert(#a&gt;math.ceil(p.length/10)+1); close(a[1],0); close(a[#a],p.length) end)
    test(function() local p=G.path({V(0,0,0),V(0,0,-20)},false); local o={profile="rectangle",width=4,height=2,sides=16,step=5,angle=8,tolerance=0.05}; local plan=E.plan(p,o); assert(plan.vertices==20 and plan.triangles==36); close(plan.perimeter[5],12) end)
    test(function() local q,closed=E.profile({profile="arch",width=4,height=2,sides=8}); assert(#q==9 and not closed) end)
    test(function() local q,closed=E.profile({profile="0,0;0,2;2,2;2,0",width=4,height=2,sides=8}); assert(#q==4 and closed); assert(not pcall(E.profile,{profile="0,0;2,2;0,2;2,0",width=4,height=2,sides=8})) end)
    test(function()
        local p=G.path({V(0,0,0),V(0,0,-10)},false)
        local l={spacing=5,side=2,height=3,yaw=0,roll=0,enabled=true,collide=true,source={}}
        local cf=L.frame(p,5,l); close((cf.Position-V(2,3,-5)).Magnitude,0)
        local plan,count=L.plan(p,{l},function() return 2 end,10); assert(#plan==1 and count==6)
        assert(not pcall(L.plan,p,{l},function() return 2 end,5))
        l.enabled=false; local _,empty=L.plan(p,{l},function() error("disabled") end,10); assert(empty==0)
    end)
    test(function() assert(not pcall(L.validate,{spacing=0,side=0,height=0,yaw=0,roll=0,enabled=true,collide=true})) end)
    return n
end
return T
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">MeshOutput</string><ProtectedString name="Source">-- Separate temporary preview and explicitly authorized asset output.
local A=game:GetService("AssetService")
local Studio=game:GetService("StudioService")
local O={}
function O.create(mesh,anchor,o,name,source,preview,canContinue)
    local part
    local ok,result=pcall(function()
        assert(canContinue(),"Editor closed or play testing started")
        local center,size=mesh:GetCenter(),mesh:GetSize()
        local content,id
        if preview then
            content=Content.fromObject(mesh)
        else
            local creatorId=game.CreatorId
            local creatorType=game.CreatorType==Enum.CreatorType.Group and Enum.AssetCreatorType.Group or Enum.AssetCreatorType.User
            if creatorId&lt;=0 then creatorId=Studio:GetUserId(); creatorType=Enum.AssetCreatorType.User end
            assert(creatorId&gt;0,"Cannot determine asset owner")
            local status,assetId=A:CreateAssetAsync(mesh,Enum.AssetType.Mesh,{
                CreatorId=creatorId,CreatorType=creatorType,Name="PathForge "..name,
                Description="Procedural mesh generated by PathForge"
            })
            assert(status==Enum.CreateAssetResult.Success and type(assetId)=="number","Mesh upload failed: "..tostring(assetId))
            id=assetId; warn("[PathForge] Uploaded mesh asset ID:",id)
            assert(canContinue(),"Editor closed or play test started; uploaded asset ID: "..tostring(id))
            content=Content.fromUri("rbxassetid://"..tostring(id))
        end
        local fidelity=preview and Enum.CollisionFidelity.Box or Enum.CollisionFidelity[o.fidelity or "Default"]
        assert(fidelity,"Invalid collision fidelity")
        local created,meshPart=pcall(function() return A:CreateMeshPartAsync(content,{CollisionFidelity=fidelity}) end)
        assert(created and meshPart,"Mesh creation failed (asset "..tostring(id).."): "..tostring(meshPart))
        part=meshPart
        assert(canContinue(),"Editor closed or play testing started")
        if id then part:SetAttribute("PathForgeMeshAssetId",id) end
        part.Name=name
        part.Size=Vector3.new(math.max(size.X,0.001),math.max(size.Y,0.001),math.max(size.Z,0.001))
        part.CFrame=CFrame.new(anchor+center)
        part.Anchored=true; part.CanCollide=not preview and o.collide; part.CanTouch=false
        if preview then part.CanQuery=false; part.Archivable=false end
        if source then
            part.Material=source.Material; part.MaterialVariant=source.MaterialVariant
            part.Color=source.Color; part.Transparency=source.Transparency; part.Reflectance=source.Reflectance
            part.TextureContent=source.TextureContent
            part.DoubleSided=source.DoubleSided; part.CastShadow=source.CastShadow
            for _,child in ipairs(source:GetChildren()) do
                if child:IsA("SurfaceAppearance") and child.Archivable then child:Clone().Parent=part end
            end
        end
        return part
    end)
    if not ok then if part then part:Destroy() end; error(result,0) end
    return result
end
return O
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Extrude</string><ProtectedString name="Source">-- Sweeps a closed convex or open cross-section along an arc-length spline.
-- All mesh vertices are shared between rings; UV and normal seams are independent.
local G=require(script.Parent.Geometry)
local A=game:GetService("AssetService")
local O=require(script.Parent.MeshOutput)
local Materials=require(script.Parent.Materials)
local E={}
local function cross(a,b) return a.X*b.Y-a.Y*b.X end
local function finite(x) return x and x==x and math.abs(x)&lt;=1000 end
function E.profile(o)
    local profile={}
    local w,h=o.width,o.height
    assert(w&gt;0 and h&gt;0,"Extrude width and height must be positive")
    local closed=true
    if o.profile=="rectangle" then
        profile={Vector2.new(-w/2,-h/2),Vector2.new(w/2,-h/2),Vector2.new(w/2,h/2),Vector2.new(-w/2,h/2)}
    elseif o.profile=="circle" then
        for i=0,o.sides-1 do local a=2*math.pi*i/o.sides; profile[#profile+1]=Vector2.new(w/2*math.cos(a),h/2*math.sin(a)) end
    elseif o.profile=="arch" then
        closed=false
        for i=0,o.sides do local a=math.pi*i/o.sides; profile[#profile+1]=Vector2.new(w/2*math.cos(a),h*math.sin(a)) end
    else
        -- Custom convex polygon, normalized only by the supplied coordinates in studs.
        for pair in string.gmatch(o.profile,"[^;]+") do
            local x,y=pair:match("^%s*([^,]+),([^,]+)%s*$")
            x=tonumber(x); y=tonumber(y)
            assert(finite(x) and finite(y),"Custom profile: x,y;x,y;... (studs)")
            profile[#profile+1]=Vector2.new(x,y)
        end
        assert(#profile&gt;=3 and #profile&lt;=64,"Custom profile needs 3–64 points")
        local area=0
        for i=1,#profile do area+=cross(profile[i],profile[i%#profile+1]) end
        assert(math.abs(area)&gt;1e-5,"Profile area is zero")
        if area&lt;0 then local rev={}; for i=#profile,1,-1 do rev[#rev+1]=profile[i] end; profile=rev end
        -- Strictly convex, ordered polygon: every other vertex left of every edge.
        for i=1,#profile do
            local j=i%#profile+1
            local a,b=profile[i],profile[j]
            assert((b-a).Magnitude&gt;1e-4,"Duplicate profile point")
            for k=1,#profile do
                if k~=i and k~=j then assert(cross(b-a,profile[k]-a)&gt;1e-6,"Profile must be a strictly convex ordered polygon") end
            end
        end
    end
    return profile,closed
end
function E.plan(path,o)
    local profile,closed=E.profile(o)
    local samples=G.adaptive(path,o.step,math.rad(o.angle),o.tolerance,2000)
    local n=#profile
    local edges=closed and n or n-1
    local triangles=(#samples-1)*edges*2+(closed and 2*(n-2) or 0)
    assert(#samples*n&lt;=60000 and triangles&lt;=20000,"Mesh budget exceeded; increase step/tolerance or reduce profile sides")
    local perimeter={0}
    for i=1,edges do perimeter[i+1]=perimeter[i]+(profile[i%n+1]-profile[i]).Magnitude end
    return {profile=profile,closed=closed,samples=samples,edges=edges,triangles=triangles,vertices=#samples*n,perimeter=perimeter}
end
function E.build(path,o,source,preview,canContinue,style)
    local plan=E.plan(path,o)
    local mesh,part
    local ok,result=pcall(function()
        mesh=A:CreateEditableMesh(); assert(mesh,"EditableMesh memory budget unavailable")
        local rings,uvs,normals={},{},{}
        local round=o.profile=="circle" or o.profile=="arch"
        local anchor=G.at(path,0)
        local roll=math.rad(o.roll)
        local co,si=math.cos(roll),math.sin(roll)
        local n=#plan.profile
        for i,d in ipairs(plan.samples) do
            local pos,_,r,u=G.frame(path,d)
            local right,up=r*co+u*si,u*co-r*si
            rings[i]={}; uvs[i]={}; normals[i]={}
            for j,q in ipairs(plan.profile) do
                rings[i][j]=mesh:AddVertex(pos-anchor+right*q.X+up*q.Y+Vector3.new(0,o.offset,0))
            end
            for j=1,plan.edges+1 do uvs[i][j]=mesh:AddUV(Vector2.new(d/o.uvLength,plan.perimeter[j]/o.uvWidth)) end
            -- Per-edge smoothing along length, with a hard profile corner.
            if round then
                local rx=o.width/2
                local ry=o.profile=="arch" and o.height or o.height/2
                for j,q in ipairs(plan.profile) do
                    local normal=(right*(q.X/(rx*rx))+up*(q.Y/(ry*ry))).Unit
                    if o.profile=="arch" then normal=-normal end -- clockwise open profile winding
                    normals[i][j]=mesh:AddNormal(normal)
                end
            else
                for j=1,plan.edges do
                    local nextJ=j%n+1
                    local edge=plan.profile[nextJ]-plan.profile[j]
                    normals[i][j]=mesh:AddNormal((right*edge.Y-up*edge.X).Unit)
                end
            end
        end
        local function tri(a,b,c,ua,ub,uc,na,nb,nc)
            local f=mesh:AddTriangle(a,b,c)
            mesh:SetFaceUVs(f,{ua,ub,uc}); mesh:SetFaceNormals(f,{na,nb,nc})
        end
        for i=1,#rings-1 do
            for j=1,plan.edges do
                local k=j%n+1
                local a,b,c,d=rings[i][j],rings[i][k],rings[i+1][k],rings[i+1][j]
                local ua,ub,uc,ud=uvs[i][j],uvs[i][j+1],uvs[i+1][j+1],uvs[i+1][j]
                local na,nb=normals[i][j],normals[i+1][j]
                -- Local right × up = -forward; this winding points outward.
                local nc=round and normals[i+1][k] or nb
                local nd=round and normals[i][k] or na
                tri(a,d,c,ua,ud,uc,na,nb,nc)
                tri(a,c,b,ua,uc,ub,na,nc,nd)
            end
        end
        if plan.closed then
            for _,i in ipairs({1,#rings}) do
                local _,f=G.frame(path,plan.samples[i])
                local normal=mesh:AddNormal(i==1 and -f or f)
                local capUV={}
                for j,q in ipairs(plan.profile) do capUV[j]=mesh:AddUV(Vector2.new(q.X/o.uvLength,q.Y/o.uvWidth)) end
                for j=2,n-1 do
                    local b,c=j,j+1
                    if i==#rings then b,c=c,b end
                    tri(rings[i][1],rings[i][b],rings[i][c],capUV[1],capUV[b],capUV[c],normal,normal,normal)
                end
            end
        end
        mesh:RemoveUnused()
        part=O.create(mesh,anchor,o,"ExtrudedMesh",source,preview,canContinue)
        if not source then
            part.Material=Enum.Material.Concrete; part.Color=Color3.fromRGB(150,150,150)
            Materials.apply(part,style)
        end
        if not plan.closed then part.DoubleSided=true; part.CanCollide=false end
        part:SetAttribute("PathForgeTriangles",plan.triangles)
        part:SetAttribute("PathForgeVertices",plan.vertices)
        return part
    end)
    if not ok then if part then part:Destroy() end; if mesh then mesh:Destroy() end; error(result,0) end
    if preview then return result,mesh end
    mesh:Destroy()
    return result
end
return E
</ProtectedString></Properties></Item>
<Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">Layers</string><ProtectedString name="Source">-- Repeat overlays: one shared spline, independent placement parameters.
local G=require(script.Parent.Geometry)
local L={MAX_LAYERS=12}
local function bounded(v,a,b) return type(v)=="number" and v==v and v&gt;=a and v&lt;=b end
function L.validate(layer)
    assert(bounded(layer.spacing,0.2,200),"Layer spacing must be 0.2–200")
    assert(bounded(layer.side,-1000,1000) and bounded(layer.height,-1000,1000),"Layer offsets outside limits")
    assert(bounded(layer.yaw,-360,360) and bounded(layer.roll,-360,360),"Layer rotation outside limits")
    assert(type(layer.enabled)=="boolean" and type(layer.collide)=="boolean","Invalid layer switches")
end
function L.frame(path,d,layer)
    local p,f,r,u=G.frame(path,d)
    p=p+r*layer.side+u*layer.height
    return CFrame.lookAt(p,p+f,u)*CFrame.Angles(0,math.rad(layer.yaw),0)*CFrame.Angles(0,0,math.rad(layer.roll))
end
function L.plan(path,layers,validAsset,budget)
    assert(#layers&lt;=L.MAX_LAYERS,"Maximum 12 repeat layers")
    local plan,total={},0
    for i,layer in ipairs(layers) do
        L.validate(layer)
        if layer.enabled then
            local n=validAsset(layer.source)
            local ds=G.instances(path,layer.spacing,math.floor((budget-total)/n))
            total+=#ds*n
            assert(total&lt;=budget,"Layer part budget exceeded")
            plan[#plan+1]={index=i,layer=layer,distances=ds}
        end
    end
    return plan,total
end
function L.build(path,layers,validAsset,cloneAsset,budget,preview)
    local plan,count=L.plan(path,layers,validAsset,budget)
    local folder=Instance.new("Folder"); folder.Name="RepeatLayers"
    local ok,err=pcall(function()
        for _,entry in ipairs(plan) do
            local l=entry.layer
            local group=Instance.new("Folder"); group.Name=string.format("%02d_%s",entry.index,l.source.Name); group.Parent=folder
            for _,d in ipairs(entry.distances) do
                local c=cloneAsset(l.source); c.Parent=group
                c:PivotTo(L.frame(path,d,l))
                local function configure(part)
                    part.Anchored=true; part.CanCollide=not preview and l.collide; part.CanTouch=false
                    if preview then part.CanQuery=false; part.Archivable=false end
                end
                if c:IsA("BasePart") then configure(c) end
                for _,obj in ipairs(c:GetDescendants()) do if obj:IsA("BasePart") then configure(obj) end end
            end
        end
    end)
    if not ok then folder:Destroy(); error(err,0) end
    return folder,count
end
function L.write(meta,layers)
    local folder=Instance.new("Folder"); folder.Name="RepeatLayers"; folder.Parent=meta
    for i,l in ipairs(layers) do
        local ref=Instance.new("ObjectValue"); ref.Name=string.format("L%02d",i); ref.Value=l.source
        for _,key in ipairs({"spacing","side","height","yaw","roll","enabled","collide"}) do ref:SetAttribute(key,l[key]) end
        ref.Parent=folder
    end
end
function L.read(meta)
    local folder=meta:FindFirstChild("RepeatLayers")
    if not folder then return {} end
    local children=folder:GetChildren()
    table.sort(children,function(a,b) return a.Name&lt;b.Name end)
    assert(#children&lt;=L.MAX_LAYERS,"Too many saved repeat layers")
    local out={}
    for _,ref in ipairs(children) do
        assert(ref:IsA("ObjectValue"),"Invalid saved repeat layer")
        local l={source=ref.Value}
        for _,key in ipairs({"spacing","side","height","yaw","roll","enabled","collide"}) do l[key]=ref:GetAttribute(key) end
        L.validate(l); out[#out+1]=l
    end
    return out
end
return L
</ProtectedString></Properties></Item>
